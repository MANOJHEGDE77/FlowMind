# Environment Configuration
ENV=development
PORT=8000
FRONTEND_PORT=5173

# Database (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL=sqlite:///./flowmind.db
# DATABASE_URL=postgresql://flowmind:flowmind_secret@localhost:5432/flowmind_db

# Security & Authentication
SECRET_KEY=flowmind-super-secure-production-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional - FlowMind has a built-in deterministic intelligence engine if unset)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# RAG & Document Intelligence
MAX_UPLOAD_SIZE_MB=25
EMBEDDING_DIMENSION=384

# Frontend public API URL
VITE_API_URL=http://localhost:8000/api
